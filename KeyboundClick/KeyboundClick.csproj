<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.1</Version>
    <Author>ForgottenR</Author>
    <Name>键影随行</Name>
    <Punchline>一键随行，键影从容。</Punchline>
    <Description>ForgottenR 的魔光键影高分助手：优先屏障、紧急读条与魔法罐，通过游戏状态确认提交效果，支持安全停手、停顿熔断、自动诊断及出发与结算确认。</Description>
    <RepoUrl>https://github.com/ForgottenR/KeyboundCompanion</RepoUrl>
    <Tags>魔光键影;KeyboundBrawler</Tags>
    <ImplicitUsings>enable</ImplicitUsings>
    <PathMap>$(MSBuildProjectDirectory)=/_/KeyboundClick</PathMap>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' == ''">$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/</DalamudLibPath>
    <AssemblySearchPaths Condition="'$(DALAMUD_HOME)' == ''">$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
